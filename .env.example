# DocuMind local development configuration. See docs/LOCAL_DEVELOPMENT.md.
# Indexing, OCR and custom generation are opt-in. Self-RAG and managed Kaggle are reserved.
# Copy to a private .env; fill required blank values locally. Never commit secrets.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
AUTH_MODE=local_only
LOG_LEVEL=INFO
LOG_DOCUMENT_CONTENT=false
LOCAL_API_TOKEN=
LOCAL_WORKSPACE_ID=3e34d85d-2ebe-4141-8024-cbfe5feec000
POSTGRES_PASSWORD=
DATABASE_URL=
CELERY_QUEUE=documind
REDIS_URL=redis://127.0.0.1:56379/0
QDRANT_URL=http://127.0.0.1:56333
# Generated by init_local.py; the same private key protects the container and client.
QDRANT_API_KEY=
# Phase 1A private filesystem adapter; Compose overrides root to its named volume.
OBJECT_STORE_ROOT=.data/objects
# Reserved for a later S3 adapter; not consumed by Phase 1A.
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_BUCKET=documind-local
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# PDF extraction is usable without indexing or a generation model.
INDEXING_ENABLED=false
OCR_ENABLED=false
OCR_MODEL_ROOT=.data/models/ocr
OCR_DPI=144
OCR_MIN_NATIVE_CHARS=8
TABLES_ENABLED=true
MAX_TABLE_CELLS=1000
MAX_UPLOAD_BYTES=20971520
MAX_WORKSPACE_DOCUMENTS=200
MAX_PDF_PAGES=100
MAX_PAGE_PIXELS=12000000
MAX_DOCUMENT_PIXELS=24000000
MAX_RENDERED_BYTES=64000000
MAX_EXTRACTED_CHARS=2000000
PARSER_TIMEOUT_SECONDS=90
OCR_LANGUAGE=en
# Reserved for future calibration; all OCR/table output currently requires human review.
OCR_FIELD_CONFIDENCE_THRESHOLD=
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=15
JOB_RETRY_BASE_SECONDS=2
JOB_RETRY_MAX_SECONDS=60
DISPATCH_POLL_SECONDS=5
ORPHAN_GRACE_SECONDS=86400
QUERY_EVENT_RETENTION_DAYS=30

# backend/documind/search_models.py pins hybrid-v3. Model names and budgets below document the profile.
MAX_PUBLICATION_CHUNKS=10000
MAX_QUERY_DOCUMENTS=50
RETRIEVAL_PROFILE=hybrid-v3
EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDING_MODEL_REVISION=f9972ac22e696a105c482202646979e33e4b5a1e
# Fixed hybrid-v3 profile: text-only, SearchQuery/Document formatting, L2 normalization.
EMBEDDING_DIMENSIONS=768
QDRANT_COLLECTION=documind_chunks_v3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
# Chunk counts use the pinned reranker tokenizer, not the Gemma tokenizer.
CHUNK_TARGET_TOKENS=240
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_MAX_INPUT_TOKENS=8192
QUERY_MAX_CONTENT_TOKENS=64
RERANKER_MAX_INPUT_TOKENS=512
RETRIEVAL_CANDIDATES_PER_BRANCH=50
RRF_K=60
RERANK_CANDIDATES=20
RETRIEVAL_TOP_K=5

# Missing models disable the relevant capability; never substitute fake output.
GENERATION_ENABLED=false
# Local-only application. Kaggle credentials stay in the local Kaggle CLI configuration.
# This legacy feature flag remains false; use scripts/run_kaggle_model.py explicitly.
MANAGED_KAGGLE_ENABLED=false
# Generated privately by scripts/init_local.py. Preserve this key when backing up credentials.
INFERENCE_SECRET_KEY=
# Operator-only exact loopback URL exception. Configure endpoints and credentials through the API.
LOCAL_CHAT_ENDPOINT=
INFERENCE_TIMEOUT_SECONDS=15
# Phase 2 embedding/reranking is fixed to CPU. Other devices are reserved.
MODEL_DEVICE=cpu
SELF_RAG_ENABLED=false
REFLECTION_LOCATION=local
# Operator-pinned model service origin, private service token and approved manifest digest.
SELF_RAG_RUNTIME_ORIGIN=
SELF_RAG_RUNTIME_TOKEN=
SELF_RAG_MANIFEST_SHA256=
# Pin the tested profile when enabling a local or Kaggle runtime, e.g. nf4-cuda or fp32-cpu.
SELF_RAG_INFERENCE_PROFILE=
# Local model services use DOCUMIND_RUNTIME_TOKEN / DOCUMIND_GENERATOR_TOKEN.
# A private Kaggle bridge uses DOCUMIND_BRIDGE_TOKEN in its own process environment.
QUERY_TIMEOUT_SECONDS=120
MODEL_MAX_CONCURRENT_RUNS=1
EXTERNAL_ANNOTATION_ENABLED=false
